# KOSKU-UI — contoh konfigurasi
# Salin ke .env.local lalu isi. JANGAN commit .env.local.

# Kunci HMAC untuk menandatangani cookie sesi (WAJIB diganti di produksi).
# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
KOSKU_SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Umur sesi dalam jam (default 12)
KOSKU_SESSION_TTL_HOURS=12

# Lokasi file SQLite (default ./data/kosku.sqlite)
KOSKU_DB_PATH=./data/kosku.sqlite

# Setel "1" kalau app dilayani lewat HTTPS.
# Cookie Secure HARUS 0 kalau masih HTTP (LAN/IP lokal) — kalau tidak, login
# akan "berhasil" tapi cookie tidak pernah dikirim balik oleh browser.
KOSKU_COOKIE_SECURE=0

# Seed akun pertama memakai variabel EMAIL/SANDI/NAMA (lihat README):
#   EMAIL=pemilik@kosku.test SANDI=rahasia-anda npm run seed
# (tanpa env, seed menanya lewat prompt; tidak ada sandi default)
